<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_edit_form_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="short_code" required="1" />
                <field name="task_sequence" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="project_edit_form_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="short_code" required="1" />
                <field name="task_sequence" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="project_project_view_form_simplified" model="ir.ui.view">
        <field name="name">project.project.create.form.inherit</field>
        <field name="model">project.project</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <setting string="Short Code" help="Short code for the project" name="short_code">
                    <field name="short_code" required="1" />
                </setting>
                <setting string="Task Sequence" help="Task sequence for the project" name="task_sequence">
                    <field name="task_sequence" readonly="1" />
                </setting>
                <setting string="Sequence Padding" help="Sequence padding for the project and sample task number" name="sequence_padding">
                    <field name="sequence_padding" />
                    <field name="sample_task_num" readonly="1" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>